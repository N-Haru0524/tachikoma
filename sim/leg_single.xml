<!--
  tachikoma / Phase 1  ―  脚1本フル最小モデル (要件 v2: 膝なし棒脚 + 足首受動サス)
  ==============================================================================
  要件 §4,§5,§8 対応:
    - 股ヨー   hip_yaw    : 能動・剛  = position サーボ (操舵/脚を向ける)
    - 股ピッチ hip_pitch  : 能動・剛  = position サーボ (前後上下に振る/車体重量を
                            支える主軸/段差越え)。★この軸のトルクを実測する★
    - 足首サス ankle_sus  : 受動      = slide ばね+ダンパ (接地衝撃吸収/凹凸追従。
                            コンプライアンスはここだけで担保)
    - 脚先ホイール wheel  : 能動駆動  = velocity サーボ (普通ホイール)

  テスト架台 (単脚でトルクを測るための最小構成):
    - carriage: 車体1本ぶんの荷重を載せる台。slide_x(前進) + slide_z(上下) の
      2自由度のみ持ち(車体ピッチ回転は他3脚が支える前提で拘束)、
      脚がこれを支える。既定 mass=1.5kg (要件の安全側総重量)。
    - 前進はホイール駆動の摩擦で行う(非駆動の受動 x)。段差はホイール前方の box。

  物理パラメータ (要件 §6):
    総重量 1.5kg / 段差 3cm / ホイール径 6.6cm(半径0.033) / 接地1脚。
-->
<mujoco model="tachikoma_leg_single_v2">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-20"/>
  </visual>

  <default>
    <!-- 既定は衝突しない(contype=0). 接地するのはホイールだけにし、
         脚ロッド⇔車体⇔ホイールの自己衝突を排除する -->
    <geom friction="1.0 0.02 0.001" density="500" contype="0" conaffinity="0"/>
    <joint damping="0.02" armature="0.003"/>
  </default>

  <worldbody>
    <light pos="0 0 1.2" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 0"
          rgba="0.35 0.4 0.45 1" friction="1.2 0.02 0.001"
          contype="1" conaffinity="1"/>

    <!-- 3cm 段差 (要件 §6). x=0.15 から先が 3cm 高い plateau。
         ホイールは +x 方向から接近して乗り上げ、そのまま上を走り続ける
         (遠端の落下イベントを避け、純粋な"上り"トルクを測るため広く取る) -->
    <geom name="step" type="box" pos="5.15 0 0.015" size="5.0 0.30 0.015"
          rgba="0.30 0.34 0.40 1" friction="1.2 0.02 0.001"
          contype="1" conaffinity="1"/>

    <!-- ================= 車体(荷重台) + 脚1本 ================= -->
    <body name="carriage" pos="0 0 0.18">
      <!-- 前進(受動: ホイール牽引で動く) と 上下(受動: 重力vs脚支持) -->
      <joint name="slide_x" type="slide" axis="1 0 0" damping="0.8"/>
      <joint name="slide_z" type="slide" axis="0 0 1" damping="0.5"/>
      <!-- 車体1本ぶんの荷重. 既定 1.5kg (torque_probe.py で上書き可) -->
      <inertial pos="0 0 0" mass="1.5" diaginertia="0.006 0.006 0.004"/>
      <geom name="body_geom" type="box" size="0.10 0.06 0.03" rgba="0.55 0.58 0.62 1"
            density="0"/>

      <!-- (1) 股ヨー: 能動・剛 (操舵). 矢状面テストでは 0 に保持 -->
      <body name="yaw" pos="0 0 -0.03">
        <joint name="hip_yaw" type="hinge" axis="0 0 1" range="-1.57 1.57" damping="0.1"/>
        <!-- ヨー機構(ブラケット+サーボ)ぶんの小質量 -->
        <inertial pos="0 0 -0.01" mass="0.03" diaginertia="1e-5 1e-5 1e-5"/>

        <!-- (2) 股ピッチ: 能動・剛 (主軸/重量支持/段差). ★トルク実測対象★ -->
        <body name="leg" pos="0 0 0">
          <joint name="hip_pitch" type="hinge" axis="0 1 0" range="-1.4 1.4" damping="0.1"/>
          <!-- 膝なしの棒一本. 軽量(density低) = 脚先を軽く俊敏に -->
          <geom name="leg_rod" type="capsule" fromto="0 0 0  0 0 -0.10" size="0.008"
                rgba="0.7 0.72 0.78 1" density="400"/>

          <!-- (3) 足首ショックアブソーバー: 受動 slide ばね (脚軸方向に伸縮) -->
          <body name="ankle" pos="0 0 -0.10">
            <joint name="ankle_sus" type="slide" axis="0 0 1" range="-0.002 0.020"
                   stiffness="2500" damping="40" springref="0"/>
            <geom name="ankle_geom" type="sphere" size="0.010" rgba="0.5 0.5 0.55 1"/>

            <!-- (4) 脚先ホイール: 能動駆動 (普通ホイール, 径3cm=半径0.015固定).
                 段差3cmと同高のため転がり越えは原理的に不可 → 脚で越える(要件§4) -->
            <body name="wheel" pos="0 0 -0.015">
              <joint name="wheel_spin" type="hinge" axis="0 1 0" damping="0.01"/>
              <geom name="wheel_geom" type="cylinder" fromto="0 -0.010 0  0 0.010 0"
                    size="0.015" rgba="0.15 0.15 0.18 1"
                    friction="1.6 0.02 0.001" density="800"
                    contype="1" conaffinity="1"
                    solref="0.005 1" solimp="0.95 0.99 0.001"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- ================= アクチュエータ (能動12軸のうち脚1本ぶん3軸) ============ -->
  <actuator>
    <!-- 股ヨー: 位置サーボ -->
    <position name="hip_yaw_pos" joint="hip_yaw" kp="20" kv="1"
              ctrlrange="-1.57 1.57" forcerange="-4 4"/>
    <!-- 股ピッチ: 位置サーボ. forcerange は実トルクを飽和させない広さ(±20 N·m).
         実測ピークがこの範囲に収まっていれば飽和なし=有効な計測 -->
    <position name="hip_pitch_pos" joint="hip_pitch" kp="60" kv="3"
              ctrlrange="-1.4 1.4" forcerange="-20 20"/>
    <!-- 脚先ホイール: 速度サーボ (rad/s). kv 高め + forcerange で
         「目標速度まで一定のストールトルク(±1.5 N·m)を出せるギヤードモータ」を近似。
         これで駆動トルク容量が目標速度に依存せず、径スタディの交絡を防ぐ -->
    <velocity name="wheel_drive" joint="wheel_spin" kv="1.5" ctrlrange="-60 60"
              forcerange="-1.5 1.5"/>
  </actuator>

  <keyframe>
    <!-- 脚を軽く前へ振った姿勢で着地. qpos=[slide_x,slide_z,yaw,pitch,ankle,wheel] -->
    <key name="home" qpos="0 0 0 0.30 0 0" ctrl="0 0.30 0"/>
  </keyframe>
</mujoco>
